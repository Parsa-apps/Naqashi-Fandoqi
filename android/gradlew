#!/usr/bin/env sh
# Simplified gradlew for GitHub Actions — uses system gradle if available, otherwise downloads

set -e

# If gradle is installed, use it
if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
fi

# Otherwise, try to find gradle via sdkman or wrapper
DIR="$(cd "$(dirname "$0")" && pwd)"
JAR="$DIR/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$JAR" ]; then
  echo "Gradle wrapper jar not found, attempting to download gradle..."
  # Fallback: try to download gradle directly if curl works for this domain
  # On GitHub Actions, this will work because internet is available
  curl -L -o /tmp/gradle.zip https://services.gradle.org/distributions/gradle-8.4-bin.zip || wget -O /tmp/gradle.zip https://services.gradle.org/distributions/gradle-8.4-bin.zip || true
  if [ -f /tmp/gradle.zip ]; then
    unzip -q /tmp/gradle.zip -d /tmp
    /tmp/gradle-8.4/bin/gradle "$@"
    exit $?
  fi
  echo "Failed to get gradle. Please ensure gradle is installed."
  exit 1
fi

# Run wrapper jar
exec java -jar "$JAR" "$@"
