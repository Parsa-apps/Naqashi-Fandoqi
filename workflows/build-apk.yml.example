name: 📱 Build Fandoqi APK — آفلاین برای همه گوشی‌ها

on:
  push:
    branches: [ main, arena/* ]
  workflow_dispatch:
  pull_request:
    branches: [ main ]

# برای اینکه GitHub اجازه ساخت workflow بده، این فایل را کپی کن به:
# .github/workflows/build-apk.yml
# سپس push کن

jobs:
  build-apk:
    name: 🤖 Build APK (Universal)
    runs-on: ubuntu-latest

    steps:
      - name: 📥 Checkout
        uses: actions/checkout@v4

      - name: ☕ Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: 🤖 Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: 🔄 Sync Web Assets to Android
        run: |
          rm -rf android/app/src/main/assets/www/*
          mkdir -p android/app/src/main/assets/www
          cp -r index.html manifest.json sw.js css js icons android/app/src/main/assets/www/
          ls -lh android/app/src/main/assets/www/

      - name: 🔧 Make gradlew executable
        run: chmod +x android/gradlew

      - name: 🔧 Setup Gradle
        uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: 8.4

      - name: 🏗️ Build Debug APK
        working-directory: android
        run: |
          ./gradlew assembleDebug --stacktrace --info || gradle assembleDebug --stacktrace

      - name: 📱 Build Release APK
        working-directory: android
        run: |
          ./gradlew assembleRelease --stacktrace || gradle assembleRelease --stacktrace

      - name: 📏 Check APKs
        run: |
          ls -lh android/app/build/outputs/apk/debug/*.apk
          ls -lh android/app/build/outputs/apk/release/*.apk || true

      - name: 📤 Upload Debug APK
        uses: actions/upload-artifact@v4
        with:
          name: fandoqi-debug-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
          retention-days: 30

      - name: 📤 Upload Release APK
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: fandoqi-release-apk
          path: android/app/build/outputs/apk/release/app-release-unsigned.apk
          retention-days: 30
          if-no-files-found: ignore
